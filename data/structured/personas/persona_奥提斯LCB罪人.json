  "voice_lines": [
    {
      "file": "奥提斯LCB语音1.ogg",
      "title": "获得时",
      "text": "||在下奥提斯。希望您能牢记我的名字。"
    },
    {
      "file": "奥提斯LCB语音2.ogg",
      "title": "早间问候",
      "text": "||早上好，经理！用过早餐了吗？您看上去精神不振，请容我提醒：合理的饮食十分重要。"
    },
    {
      "file": "奥提斯LCB语音3.ogg",
      "title": "午间问候",
      "text": "||一位像您一样杰出的领导者，绝不应困于独自用餐的悲哀境地！我将与您一同用餐！"
    },
    {
      "file": "奥提斯LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||我建议您早些入睡，以良好的状态处理明天的事务。"
    },
    {
      "file": "奥提斯LCB语音5.ogg",
      "title": "对话 1",
      "text": "||尽管忙碌，若是有需要，我完全可以暂停手中一切事项，来回应您的召唤。"
    },
    {
      "file": "奥提斯LCB语音6.ogg",
      "title": "对话 2",
      "text": "||为求胜利，您可以做出何等牺牲，经理？若能得胜，您又愿意不择手段到何种地步？"
    },
    {
      "file": "奥提斯LCB语音7.ogg",
      "title": "对话 3",
      "text": "||要和未曾亲临战场的一群新兵一同执行任务，何等荒谬……啊，我绝非在指您，经理。"
    },
    {
      "file": "奥提斯LCB语音8.ogg",
      "title": "闲置",
      "text": "||经理？独自外出十分危险，尤其对您这样没有战斗能力的人而言！"
    },
    {
      "file": "奥提斯LCB语音9.ogg",
      "title": "人格出战",
      "text": "||即刻出击。"
    },
    {
      "file": "奥提斯LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||奥提斯，参战。"
    },
    {
      "file": "奥提斯LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||有何命令，经理？"
    },
    {
      "file": "奥提斯LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||遵命。"
    },
    {
      "file": "奥提斯LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||战略实施很顺利。"
    },
    {
      "file": "奥提斯LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||呃！"
    },
    {
      "file": "奥提斯LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||一计良策。"
    },
    {
      "file": "奥提斯LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||新兵总是这样。"
    },
    {
      "file": "奥提斯LCB语音17.ogg",
      "title": "判定成功",
      "text": "||作战胜利完全归功于您优秀的指挥。"
    },
    {
      "file": "奥提斯LCB语音18.ogg",
      "title": "判定失败",
      "text": "||是在下的失误……"
    },
    {
      "file": "奥提斯LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||一如既往的杰出，经理！"
    },
    {
      "file": "奥提斯LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||这胜果99%源于您的睿智领导，仅有1%是在下的绵薄之力！"
    },
    {
      "file": "奥提斯LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||无论如何，这并非你我二人的过错，经理。"
    }
  ],
