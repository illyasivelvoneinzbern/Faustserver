  "battle_passive": "人格被动1090101\n人格被动1090121",
  "support_passive": "",
  "notes": "",
  "voice_lines": [
    {
      "file": "罗佳LCB语音1.ogg",
      "title": "获得时",
      "text": "||你好~我是罗佳。我有个更长的名字，但那样称呼的话未免太冷淡了点，所以叫我罗佳就好~"
    },
    {
      "file": "罗佳LCB语音2.ogg",
      "title": "早间问候",
      "text": "||哈欠~这么早就醒了？我就再睡一会儿，真希望有人能给我准备早餐啊。"
    },
    {
      "file": "罗佳LCB语音3.ogg",
      "title": "午间问候",
      "text": "||午餐吃了什么？我想来一份鲜嫩多汁的……大肉排，可惜浮士德说不行。"
    },
    {
      "file": "罗佳LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||睡不着吗？我们俩来局扑克怎么样？就玩“单挑”吧。呦呼。"
    },
    {
      "file": "罗佳LCB语音5.ogg",
      "title": "对话 1",
      "text": "||虽然人们叫我远离金钱……但是没门。虽然拜金主义会毁人一生，但像我这样爱钱的人一定会成功的。"
    },
    {
      "file": "罗佳LCB语音6.ogg",
      "title": "对话 2",
      "text": "||但丁，偶尔劳逸结合一下也可以吧？谁都需要休息嘛。……所以出去买点好吃的回来吧？嗯？"
    },
    {
      "file": "罗佳LCB语音7.ogg",
      "title": "对话 3",
      "text": "||我最喜欢的事情……就是一边享用让人垂涎欲滴的上等肉一边打牌。当然，不管玩什么我都会赢。"
    },
    {
      "file": "罗佳LCB语音8.ogg",
      "title": "对话 4",
      "text": "||我的家乡可不是一般的冷。相比之下这里简直就是温室。我有时会在想这里是不是热过头了。但丁的家乡呢？啊，对哦……记起来的话一定要告诉我哦？"
    },
    {
      "file": "罗佳LCB语音9.ogg",
      "title": "对话 5",
      "text": "||你可真是个奇怪的人，但丁。你怎么能把生活过得如此无趣？如果你丢掉头的时候把你喜欢的东西也一并忘掉了的话……嗯，那可真令人难过……"
    },
    {
      "file": "罗佳LCB语音10.ogg",
      "title": "闲置",
      "text": "||但丁？你是出去买好吃的了吧？我会期待你的哦？"
    },
    {
      "file": "罗佳LCB语音11.ogg",
      "title": "人格出战",
      "text": "||需要帮忙吗？"
    },
    {
      "file": "罗佳LCB语音12.ogg",
      "title": "进入战斗",
      "text": "||快点搞定然后吃饭去~"
    },
    {
      "file": "罗佳LCB语音13.ogg",
      "title": "战斗中选中人格",
      "text": "||怎么啦？想我了吗？"
    },
    {
      "file": "罗佳LCB语音14.ogg",
      "title": "进行攻击",
      "text": "||我去去就回~"
    },
    {
      "file": "罗佳LCB语音15.ogg",
      "title": "敌方混乱",
      "text": "||就这点能耐吗？"
    },
    {
      "file": "罗佳LCB语音16.ogg",
      "title": "陷入混乱",
      "text": "||呃……"
    },
    {
      "file": "罗佳LCB语音17.ogg",
      "title": "击杀敌方",
      "text": "||搞定！回去记得请我一顿，但丁~"
    },
    {
      "file": "罗佳LCB语音18.ogg",
      "title": "友方阵亡",
      "text": "||哦天……但丁，又要让你受苦了~"
    },
    {
      "file": "罗佳LCB语音19.ogg",
      "title": "判定成功",
      "text": "||换做其他人可不一定做得到哦？"
    },
    {
      "file": "罗佳LCB语音20.ogg",
      "title": "判定失败",
      "text": "||哈~我可警告过你喽。"
    },
    {
      "file": "罗佳LCB语音21.ogg",
      "title": "战斗胜利",
      "text": "||小菜一碟~比起称赞……你懂得？"
    },
    {
      "file": "罗佳LCB语音22.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||完~美~！只不过对我而言好像还差点意思？"
    },
    {
      "file": "罗佳LCB语音23.ogg",
      "title": "战斗失败",
      "text": "||你可以做的更好的~这可不怪我哦？"
    }
  ],
