  "voice_lines": [
    {
      "file": "李箱LCB语音1.ogg",
      "title": "获得时",
      "text": "||我是李箱。以上。"
    },
    {
      "file": "李箱LCB语音2.ogg",
      "title": "早间问候",
      "text": "||今早可还安好？于夜间遗忘之物是否全部忆起？"
    },
    {
      "file": "李箱LCB语音3.ogg",
      "title": "午间问候",
      "text": "||太阳注视着我的脸。即使我闭上双眼也仍旧如此。"
    },
    {
      "file": "李箱LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||日渐西山，而仅有我于此伫立。"
    },
    {
      "file": "李箱LCB语音5.ogg",
      "title": "对话 1",
      "text": "||你可曾知晓重返过去，或是推却未来之法？"
    },
    {
      "file": "李箱LCB语音6.ogg",
      "title": "对话 2",
      "text": "||某时某日，我停下脚步，将自己幽禁于这巴士上。"
    },
    {
      "file": "李箱LCB语音7.ogg",
      "title": "对话 3",
      "text": "||你的时钟不曾停歇。它不停不休地让我归乡。"
    },
    {
      "file": "李箱LCB语音8.ogg",
      "title": "闲置",
      "text": "||你，终于找到你的目的地了？"
    },
    {
      "file": "李箱LCB语音9.ogg",
      "title": "人格出战",
      "text": "||请带路。"
    },
    {
      "file": "李箱LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||终点处有诸多肿瘤。"
    },
    {
      "file": "李箱LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||可是找到了所盼之物？"
    },
    {
      "file": "李箱LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||我将摘除肿瘤。"
    },
    {
      "file": "李箱LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||络绎鼠辈。"
    },
    {
      "file": "李箱LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||唔……"
    },
    {
      "file": "李箱LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||瘤之镜已然碎裂。"
    },
    {
      "file": "李箱LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||该拨动你的指针了。"
    },
    {
      "file": "李箱LCB语音17.ogg",
      "title": "判定成功",
      "text": "||顿生愉悦。"
    },
    {
      "file": "李箱LCB语音18.ogg",
      "title": "判定失败",
      "text": "||人终将绝望。"
    },
    {
      "file": "李箱LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||胜利并非永恒。因此我淡然相对。"
    },
    {
      "file": "李箱LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||此为辛劳之代价。感觉此身已然枯萎。"
    },
    {
      "file": "李箱LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||苍白失色，茫然无措……"
    }
  ],
