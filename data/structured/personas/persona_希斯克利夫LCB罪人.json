  "voice_lines": [
    {
      "file": "希斯克利夫LCB语音1.ogg",
      "title": "获得时",
      "text": "||希斯克利夫。把人砸碎是我的长项。当然，得在我愿意的时候。"
    },
    {
      "file": "希斯克利夫LCB语音2.ogg",
      "title": "早间问候",
      "text": "||一大早的把钟收起来……看着不顺眼。"
    },
    {
      "file": "希斯克利夫LCB语音3.ogg",
      "title": "午间问候",
      "text": "||怎么样？您午饭吃了什么？你不会是期待着和我进行这样的对话吧？"
    },
    {
      "file": "希斯克利夫LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||等下，如果说又要进行什么作战啊训练啊之类的东西的话劝你考虑一下再张嘴。"
    },
    {
      "file": "希斯克利夫LCB语音5.ogg",
      "title": "对话 1",
      "text": "||别以为是执行经理就可以进行训诫或者是规划一些没用的作战计划。我可不听别人的话。"
    },
    {
      "file": "希斯克利夫LCB语音6.ogg",
      "title": "对话 2",
      "text": "||老兄，你不好奇吗？关于那个钟表内部是个什么样的……哈，玩笑而已。干嘛浑身发抖啊？"
    },
    {
      "file": "希斯克利夫LCB语音7.ogg",
      "title": "对话 3",
      "text": "||别跟我长篇大论。如果是用拳头的话倒是说不定。"
    },
    {
      "file": "希斯克利夫LCB语音8.ogg",
      "title": "闲置",
      "text": "||好啊，想吃我一记是吧？给我等着。"
    },
    {
      "file": "希斯克利夫LCB语音9.ogg",
      "title": "人格出战",
      "text": "||刚好浑身不自在。是时候去砸碎一些东西了！"
    },
    {
      "file": "希斯克利夫LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||没必要拖拖拉拉的，直接开打！"
    },
    {
      "file": "希斯克利夫LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||怎么？什么事？"
    },
    {
      "file": "希斯克利夫LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||我先上了！"
    },
    {
      "file": "希斯克利夫LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||哈哈，怎么样？"
    },
    {
      "file": "希斯克利夫LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||呃……！"
    },
    {
      "file": "希斯克利夫LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||小菜一碟。"
    },
    {
      "file": "希斯克利夫LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||搞啥，这就被打烂了？"
    },
    {
      "file": "希斯克利夫LCB语音17.ogg",
      "title": "判定成功",
      "text": "||你咋看起来那么自豪？这可都是我办的。"
    },
    {
      "file": "希斯克利夫LCB语音18.ogg",
      "title": "判定失败",
      "text": "||……让人火大。我不是让你找别人去了吗？"
    },
    {
      "file": "希斯克利夫LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||嘛，就这种程度我还不至于高兴到嬉皮笑脸的。"
    },
    {
      "file": "希斯克利夫LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||哼，看到了吗？一通乱打全干碎！"
    },
    {
      "file": "希斯克利夫LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||妈的，真让人火大！哥们你不会就这么放了他们吧？"
    }
  ],
