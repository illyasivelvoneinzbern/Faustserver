  "notes": "",
  "voice_lines": [
    {
      "file": "辛克莱LCB语音1.ogg",
      "title": "获得时",
      "text": "||我是辛克莱……埃米尔・辛克莱。啊，编号是……呃……十一号。"
    },
    {
      "file": "辛克莱LCB语音2.ogg",
      "title": "早间问候",
      "text": "||早安！您昨天睡得……啊，经理您也能入睡……对吧？"
    },
    {
      "file": "辛克莱LCB语音3.ogg",
      "title": "午间问候",
      "text": "||这是我一天中最舒服的时候了。下午也请加油，经理。"
    },
    {
      "file": "辛克莱LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||您今天过得怎么样？我……感觉自己今天并没有很好做到集中精神工作。"
    },
    {
      "file": "辛克莱LCB语音5.ogg",
      "title": "对话 1",
      "text": "||如果是以前我根本就无法想象……啊，我并不是说我对现在的工作心存不满……只是觉得有些不可思议。"
    },
    {
      "file": "辛克莱LCB语音6.ogg",
      "title": "对话 2",
      "text": "||经理真了不起……我还在因为无法适应而焦头烂额的时候，您却能在失忆的前提下熟练地领导我们。"
    },
    {
      "file": "辛克莱LCB语音7.ogg",
      "title": "对话 3",
      "text": "||您看。罗佳小姐给了我一点零食。我打算省着点吃。嘿嘿。"
    },
    {
      "file": "辛克莱LCB语音8.ogg",
      "title": "对话 4",
      "text": "||但丁经理……您的头变成了这样以后……真的没关系吗？您所看到的世界……还是正常的吗？"
    },
    {
      "file": "辛克莱LCB语音9.ogg",
      "title": "对话 5",
      "text": "||但丁经理，失去了以前的记忆，是不是就不会觉得懊悔？虽然这样说会很无礼，但是……我真的很羡慕您。因为您不会被过去所困扰。"
    },
    {
      "file": "辛克莱LCB语音10.ogg",
      "title": "闲置",
      "text": "||经理……？您去哪了？您在忙吗？"
    },
    {
      "file": "辛克莱LCB语音11.ogg",
      "title": "人格出战",
      "text": "||呃……我吗？嗯……我会尽力的……"
    },
    {
      "file": "辛克莱LCB语音12.ogg",
      "title": "进入战斗",
      "text": "||这应该是极限了吧……？"
    },
    {
      "file": "辛克莱LCB语音13.ogg",
      "title": "战斗中选中人格",
      "text": "||我做错什么了吗……？"
    },
    {
      "file": "辛克莱LCB语音14.ogg",
      "title": "进行攻击",
      "text": "||我会试试的……!"
    },
    {
      "file": "辛克莱LCB语音15.ogg",
      "title": "敌方混乱",
      "text": "||我做到了，对吧……？"
    },
    {
      "file": "辛克莱LCB语音16.ogg",
      "title": "陷入混乱",
      "text": "||呃……!"
    },
    {
      "file": "辛克莱LCB语音17.ogg",
      "title": "击杀敌方",
      "text": "||我做到了！"
    },
    {
      "file": "辛克莱LCB语音18.ogg",
      "title": "友方阵亡",
      "text": "||我也会变成那样吗……?"
    },
    {
      "file": "辛克莱LCB语音19.ogg",
      "title": "判定成功",
      "text": "||太好了，我做到了……"
    },
    {
      "file": "辛克莱LCB语音20.ogg",
      "title": "判定失败",
      "text": "||这都是我的错……"
    },
    {
      "file": "辛克莱LCB语音21.ogg",
      "title": "战斗胜利",
      "text": "||嗯……我们做到了吗？那我就放心了。"
    },
    {
      "file": "辛克莱LCB语音22.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||这应该不是我的功劳。但还是谢谢经理您的夸奖。一时间，我想起了妈妈。"
    },
    {
      "file": "辛克莱LCB语音23.ogg",
      "title": "战斗失败",
      "text": "||对不起。我应该做的更好的……看来我还有很多尚未成熟的地方。"
    }
  ],
