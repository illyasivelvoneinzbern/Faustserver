  "voice_lines": [
    {
      "file": "堂吉诃德LCB语音1.ogg",
      "title": "获得时",
      "text": "||已至吾之时刻？吾乃，堂吉诃德！"
    },
    {
      "file": "堂吉诃德LCB语音2.ogg",
      "title": "早间问候",
      "text": "||哈欠……经理老爷可真是个勤恳的人啊。这个点是怎么让自己保持清醒的啊…？"
    },
    {
      "file": "堂吉诃德LCB语音3.ogg",
      "title": "午间问候",
      "text": "||汝对午饭有何打算？听闻罗佳打听到了不错的食堂，吾现在十分期待。"
    },
    {
      "file": "堂吉诃德LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||今天的星星格外明亮。经理老爷也看得见星星吗？"
    },
    {
      "file": "堂吉诃德LCB语音5.ogg",
      "title": "对话 1",
      "text": "||经理老爷，要欣赏一下吗？此皆吾之珍宝，呼呼……其中不乏吾竭尽全力才得到的限量版！"
    },
    {
      "file": "堂吉诃德LCB语音6.ogg",
      "title": "对话 2",
      "text": "||请把目光投向那些收尾人吧，他们正为了这世间的正义而奔波！不觉得他们是如此耀眼吗？"
    },
    {
      "file": "堂吉诃德LCB语音7.ogg",
      "title": "对话 3",
      "text": "||经理老爷最喜欢的收尾人是谁？分您一个徽章贴在衣服上如何？"
    },
    {
      "file": "堂吉诃德LCB语音8.ogg",
      "title": "闲置",
      "text": "||经理老爷！！！！！把吾丢在这里上哪儿去啦！！！！！！！！！！！"
    },
    {
      "file": "堂吉诃德LCB语音9.ogg",
      "title": "人格出战",
      "text": "||驰骋吧！驽骍难得！"
    },
    {
      "file": "堂吉诃德LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||轮到吾出场了吗！"
    },
    {
      "file": "堂吉诃德LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||原来您一直在注视着吾！"
    },
    {
      "file": "堂吉诃德LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||出征！"
    },
    {
      "file": "堂吉诃德LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||如我所料！"
    },
    {
      "file": "堂吉诃德LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||啊！"
    },
    {
      "file": "堂吉诃德LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||大捷！"
    },
    {
      "file": "堂吉诃德LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||经理老爷，虽然会很辛苦，但还是拜托您了！"
    },
    {
      "file": "堂吉诃德LCB语音17.ogg",
      "title": "判定成功",
      "text": "||吾岂敢自满！历史必将铭记此功！"
    },
    {
      "file": "堂吉诃德LCB语音18.ogg",
      "title": "判定失败",
      "text": "||战胜逆境者方为英雄。来日吾等将再度出征！"
    },
    {
      "file": "堂吉诃德LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||实然！正义永存！"
    },
    {
      "file": "堂吉诃德LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||吾果然有着成为伟大收尾人的资质！！！！哇哈哈哈哈！！！！"
    },
    {
      "file": "堂吉诃德LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||咳……你们会……付出……代价的……"
    }
  ],
