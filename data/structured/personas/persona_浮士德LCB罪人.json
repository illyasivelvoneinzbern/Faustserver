  "voice_lines": [
    {
      "file": "浮士德LCB语音1.ogg",
      "title": "获得时",
      "text": "||浮士德。你人生中绝无仅有的天才。"
    },
    {
      "file": "浮士德LCB语音2.ogg",
      "title": "早间问候",
      "text": "||入睡三小时后我就会醒来。我曾以为这是自然的现象，直至后来，我才意识到人们并非皆是如此。"
    },
    {
      "file": "浮士德LCB语音3.ogg",
      "title": "午间问候",
      "text": "||浮士德认为，日光浴是一项有益活动。"
    },
    {
      "file": "浮士德LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||虽然我从未刻意培养过什么兴趣爱好，不过有那么一段时间，我很享受观星所带来的乐趣。"
    },
    {
      "file": "浮士德LCB语音5.ogg",
      "title": "对话 1",
      "text": "||……如果你倾向于把人叫到面前后再开始组织语言，那我建议你使用书面文件传达消息。"
    },
    {
      "file": "浮士德LCB语音6.ogg",
      "title": "对话 2",
      "text": "||我正在考虑在与不同罪人对话时选用不同专业水平的词汇。每句话都要重复两遍以上，实在是缺乏效率。"
    },
    {
      "file": "浮士德LCB语音7.ogg",
      "title": "对话 3",
      "text": "||但丁，我无所不知并不代表我有回答你每一个问题的义务。"
    },
    {
      "file": "浮士德LCB语音8.ogg",
      "title": "闲置",
      "text": "||这些误差还在容许范围之内。"
    },
    {
      "file": "浮士德LCB语音9.ogg",
      "title": "人格出战",
      "text": "||我将随行。"
    },
    {
      "file": "浮士德LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||已完成随行准备。"
    },
    {
      "file": "浮士德LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||有什么事吗，经理？"
    },
    {
      "file": "浮士德LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||开始行动。"
    },
    {
      "file": "浮士德LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||机会来了。"
    },
    {
      "file": "浮士德LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||呃!"
    },
    {
      "file": "浮士德LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||理所当然的结果。"
    },
    {
      "file": "浮士德LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||这并非最有效率的选择。"
    },
    {
      "file": "浮士德LCB语音17.ogg",
      "title": "判定成功",
      "text": "||不要因成功骄傲自满。"
    },
    {
      "file": "浮士德LCB语音18.ogg",
      "title": "判定失败",
      "text": "||不要对失败耿耿于怀。"
    },
    {
      "file": "浮士德LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||有什么值得为此高兴的理由吗？"
    },
    {
      "file": "浮士德LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||你比我预想的要优秀一点。"
    },
    {
      "file": "浮士德LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||我本就没抱什么期望。"
    }
  ],
