  "voice_lines": [
    {
      "file": "良秀LCB语音1.ogg",
      "title": "获得时",
      "text": "||良秀。夜良秀苦……噗。"
    },
    {
      "file": "良秀LCB语音2.ogg",
      "title": "早间问候",
      "text": "||为什么你一大早开始就转来转去的？难道是在找电池吗？"
    },
    {
      "file": "良秀LCB语音3.ogg",
      "title": "午间问候",
      "text": "||没错，疲倦的时候没有什么能比饭后一根烟更棒的了。"
    },
    {
      "file": "良秀LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||这里的人都很枯燥。如果目睹到真正的艺术品，他们一定会大开眼界的。"
    },
    {
      "file": "良秀LCB语音5.ogg",
      "title": "对话 1",
      "text": "||自从见过像样点的艺术也颇有时日了。最近人们也不过是大量制造似曾相识的东西。哼。"
    },
    {
      "file": "良秀LCB语音6.ogg",
      "title": "对话 2",
      "text": "||如果想和我相处的话，至少带好打火机。时钟。"
    },
    {
      "file": "良秀LCB语音7.ogg",
      "title": "对话 3",
      "text": "||如果你不是要告诉我现在几点的话就不要来烦我了。"
    },
    {
      "file": "良秀LCB语音8.ogg",
      "title": "闲置",
      "text": "||先搭话再消失……这是哪条后巷的习俗？"
    },
    {
      "file": "良秀LCB语音9.ogg",
      "title": "人格出战",
      "text": "||让我来展示艺术吧。"
    },
    {
      "file": "良秀LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||如果是像样点的艺术的话，会更好些吧。"
    },
    {
      "file": "良秀LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||带上打火机了吗？"
    },
    {
      "file": "良秀LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||让你看看什么是艺术吧。"
    },
    {
      "file": "良秀LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||等等。还没有结束。"
    },
    {
      "file": "良秀LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||嘁!"
    },
    {
      "file": "良秀LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||不怎么美观啊。"
    },
    {
      "file": "良秀LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||看起来不怎么样啊。"
    },
    {
      "file": "良秀LCB语音17.ogg",
      "title": "判定成功",
      "text": "||创造了一幅佳作。"
    },
    {
      "file": "良秀LCB语音18.ogg",
      "title": "判定失败",
      "text": "||我可照你说的做了。"
    },
    {
      "file": "良秀LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||无聊。令人索然无味。"
    },
    {
      "file": "良秀LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||区区这种程度就浮躁起来，便没有艺术家的资格。"
    },
    {
      "file": "良秀LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||艺·失·人·长。艺术虽失败，人生仍漫长。"
    }
  ],
