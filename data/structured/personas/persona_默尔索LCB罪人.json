  "voice_lines": [
    {
      "file": "默尔索LCB语音1.ogg",
      "title": "获得时",
      "text": "||默尔索。请这样称呼我，经理。"
    },
    {
      "file": "默尔索LCB语音2.ogg",
      "title": "早间问候",
      "text": "||社规里明确表示员工应在规定时间起床。看来包括您在内的大多数罪人并不知道此事。"
    },
    {
      "file": "默尔索LCB语音3.ogg",
      "title": "午间问候",
      "text": "||如果您问我如何度过午后时光……没有规定表明该做什么。"
    },
    {
      "file": "默尔索LCB语音4.ogg",
      "title": "晚间问候",
      "text": "||如果一定要我比较，我在一天中喜欢白天胜过黑夜。黑暗遮掩视野，难视之物难解。"
    },
    {
      "file": "默尔索LCB语音5.ogg",
      "title": "对话 1",
      "text": "||有什么需要我做的吗，经理？如有特殊原因，请指明。"
    },
    {
      "file": "默尔索LCB语音6.ogg",
      "title": "对话 2",
      "text": "||人们建议我平日里多笑笑。您也如此希望吗，经理？"
    },
    {
      "file": "默尔索LCB语音7.ogg",
      "title": "对话 3",
      "text": "||……您频繁向我搭话。是执行经理的规定指示您如此的吗？"
    },
    {
      "file": "默尔索LCB语音8.ogg",
      "title": "闲置",
      "text": "||我将在这里等您回来。"
    },
    {
      "file": "默尔索LCB语音9.ogg",
      "title": "人格出战",
      "text": "||好，如果您希望如此。"
    },
    {
      "file": "默尔索LCB语音10.ogg",
      "title": "进入战斗",
      "text": "||若规定如此。我将遵从。"
    },
    {
      "file": "默尔索LCB语音11.ogg",
      "title": "战斗中选中人格",
      "text": "||有问题吗，经理？"
    },
    {
      "file": "默尔索LCB语音12.ogg",
      "title": "进行攻击",
      "text": "||我会根据规定执行命令。"
    },
    {
      "file": "默尔索LCB语音13.ogg",
      "title": "敌方混乱",
      "text": "||等待您的下一步指令。"
    },
    {
      "file": "默尔索LCB语音14.ogg",
      "title": "陷入混乱",
      "text": "||呃！"
    },
    {
      "file": "默尔索LCB语音15.ogg",
      "title": "击杀敌方",
      "text": "||指令已完成。"
    },
    {
      "file": "默尔索LCB语音16.ogg",
      "title": "友方阵亡",
      "text": "||将按规定拜托于您。"
    },
    {
      "file": "默尔索LCB语音17.ogg",
      "title": "判定成功",
      "text": "||做到了。"
    },
    {
      "file": "默尔索LCB语音18.ogg",
      "title": "判定失败",
      "text": "||失败了。"
    },
    {
      "file": "默尔索LCB语音19.ogg",
      "title": "战斗胜利",
      "text": "||我只是按命令行事。"
    },
    {
      "file": "默尔索LCB语音20.ogg",
      "title": "EX CLEAR战斗胜利",
      "text": "||本应如此，不必褒扬。"
    },
    {
      "file": "默尔索LCB语音21.ogg",
      "title": "战斗失败",
      "text": "||请求您重新修订策略。"
    }
  ],
