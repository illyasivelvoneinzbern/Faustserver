# ========================================
# 边狱巴士 RAG Agent — 环境变量配置
# ========================================
# 复制此文件为 .env 并填入实际值

# ── LLM API Key（必填，DeepSeek 推荐，性价比最高）──
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Embedding API Key ──
# 推荐硅基流动（SiliconFlow），国内直连，注册 https://siliconflow.cn 获取 Key
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 备选：OpenAI 官方（需代理）
# OPENAI_API_KEY=your_openai_api_key_here

# ── NapCatQQ WebSocket Token（可选）──
# config.yaml 的 napcat.token 使用 ${NAPCAT_TOKEN} 占位符。
# 若 NapCat 配置了 access_token，请填入（此前明文写在 config.yaml，现迁移到此处）；
# 未配置鉴权则留空即可。
NAPCAT_TOKEN=

# ── NapCatQQ 机器人自身 QQ 号（必填，P21-C）──
# 群聊 @机器人 检测需要知道 bot 自身的 QQ 号。
# config.yaml 的 napcat.bot_qq 使用 ${NAPCAT_QQ} 占位符；请填入 bot 真实 QQ 号。
NAPCAT_QQ=
